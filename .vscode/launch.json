{
    "configurations": [
        {
            "name": "Web UI (dev)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "ui.app:create_app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/engine:${PYTHONPATH}"
            }
        }
    ]
}
